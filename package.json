{
  "name": "piorebosteio",
  "version": "1.5.57",
  "description": "Rode de 1 a 4 contas de Poke Idle IO ao mesmo tempo, em uma janela so / Run 1 to 4 Poke Idle IO accounts at once, in a single window",
  "main": "main.js",
  "author": "souonailo",
  "scripts": {
    "start": "electron .",
    "test:panels": "electron test/panel-controls.test.js",
    "test:performance": "node test/runtime-performance.test.js",
    "test:guest-runtime": "node test/guest-runtime.test.js",
    "test:auto-supply": "node test/auto-supply.test.js",
    "test:auto-supply-integration": "electron test/auto-supply-electron.test.js",
    "test:tracking": "electron test/game-tracking.test.js",
    "test:sync": "node test/upstream-sync.test.js",
    "test:capture-value": "electron test/capture-value.test.js",
    "test:catch-nota": "electron test/catch-nota.test.js",
    "test:userscripts": "electron test/userscripts.test.js",
    "test:memory-probe": "node test/memory-probe.test.js",
    "mem:run": "electron . --mem-probe --mem-tray-after=300 --mem-show-after=2100 --mem-duration=2160",
    "mem:bench": "node tools/mem-bench.js",
    "mem:report": "node tools/mem-report.js"
  },
  "keywords": [
    "electron",
    "multi-account",
    "poke-idle-io",
    "idle-game"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.1.1"
  }
}
